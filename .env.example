# Build-time fallbacks only. Normal deployments should edit public/app-config.js,
# which can also be replaced in dist after the build without rebuilding.
VITE_APP_MODE=api

VITE_APP_NAME=SystemPro
VITE_APP_DESCRIPTION=SystemPro enterprise operations platform for IoT, energy and business workflows.
VITE_PROJECT_URL=https://gitee.com/sitepulse/system-pro

# Keep empty when public/app-config.js supplies apiBaseUrl or for same-origin
# /api requests. For local proxy development, copy this file to .env.local.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=

# Disabled by default so the public console never consumes an operator's model
# quota. Enable only after the configured API backend exposes compatible AI APIs.
VITE_AI_ASSISTANT_ENABLED=false

# Optional absolute CDN/object-storage prefix for hashed frontend assets.
# Keep empty for same-origin delivery.
VITE_ASSET_BASE_URL=
